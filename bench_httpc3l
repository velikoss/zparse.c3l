module bench;

import std::io;
import std::time::clock;

import zparse1;      // original zparse
import zparseng;     // current zparse
import http::parser; // lsfratel/http.c3l

const usz ITERS      = 2_000_000;
const usz WARMUP     = 100_000;
const usz CHUNK_ITERS = 200_000;
const usz SLOW_ITERS  = 20_000;

const String REQ = "GET /wp-content/uploads/2010/03/hello-kitty-darth-vader-pink.jpg HTTP/1.1\r\n"
                   "Host: www.kittyhell.com\r\n"
                   "User-Agent: Mozilla/5.0 (Macintosh; U; Intel Mac OS X 10.6; en-US; rv:1.9.2.3) Gecko/20100401 Firefox/3.6.3 Pathtraq/0.9\r\n"
                   "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\n"
                   "Accept-Language: ja,en-us;q=0.7,en;q=0.3\r\n"
                   "Accept-Encoding: gzip,deflate\r\n"
                   "Accept-Charset: Shift_JIS,utf-8;q=0.7,*;q=0.7\r\n"
                   "Keep-Alive: 115\r\n"
                   "Connection: keep-alive\r\n"
                   "Cookie: wp_ttref=lstes180; _x_ref=q2; _gt_jp=jp; rtfrequency=0; __utma=1.1\r\n"
                   "\r\n";

const usz EXPECT_HEADERS = 9;

ulong sink;

struct Ctx { usz headers; ulong sink; }

fn void on_request_line(parser::Parser* p, char[] method, char[] target, char[] version, void* ud)
{
	Ctx* c = ud;
	c.sink += method.len + target.len + version.len;
}

fn void on_header(parser::Parser* p, char[] name, char[] value, void* ud)
{
	Ctx* c = ud;
	c.headers++;
	c.sink += name.len + value.len;
}

fn parser::Settings full_settings() => { .on_request_line = &on_request_line, .on_header = &on_header };

fn bool check(char[] buf)
{
	ZString z = (ZString)buf.ptr;
	bool ok = true;

	// zparse1
	zparse1::ZHttpRequest r1;
	if (!zparse1::parse(&r1, z, buf.len))
	{
		io::printn("  zparse1  FAIL: parse returned false");
		ok = false;
	}
	else if (r1.header_count != (int)EXPECT_HEADERS)
	{
		io::printfn("  zparse1  FAIL: headers=%d", r1.header_count);
		ok = false;
	}
	else
	{
		io::printfn("  zparse1  ok   headers=%d", r1.header_count);
	}

	// whole buffer
	zparseng::ZHttpRequest rn;
	usz? n = zparseng::parse(&rn, z, buf.len);
	if (catch e = n)
	{
		io::printfn("  zparseng FAIL: %s", e);
		ok = false;
	}
	else if (n != buf.len || rn.header_count != (int)EXPECT_HEADERS)
	{
		io::printfn("  zparseng FAIL: consumed=%d/%d headers=%d", n, buf.len, rn.header_count);
		ok = false;
	}
	else
	{
		io::printfn("  zparseng ok   consumed=%d headers=%d", n, rn.header_count);
	}

	// split arrival
	foreach (chunk : (usz[]) { 1, 7, 64, 533 })
	{
		zparseng::ZHttpRequest rr;
		zparseng::ZHttpParser p = { .request = &rr };
		usz have = 0;
		bool done = false;
		while (have < buf.len)
		{
			have += chunk;
			if (have > buf.len) have = buf.len;
			usz? m = p.parse(z, have);
			if (catch e = m)
			{
				if (e == zparseng::INCOMPLETE) continue;
				io::printfn("  zparseng FAIL chunk=%d: %s", chunk, e);
				ok = false;
				break;
			}
			if (m != buf.len || rr.header_count != (int)EXPECT_HEADERS)
			{
				io::printfn("  zparseng FAIL chunk=%d: consumed=%d headers=%d", chunk, m, rr.header_count);
				ok = false;
			}
			done = true;
			break;
		}
		if (!done && ok)
		{
			io::printfn("  zparseng FAIL chunk=%d: never completed", chunk);
			ok = false;
		}
	}

	// http.c3l
	Ctx ctx;
	parser::Settings st = full_settings();
	parser::Parser hp;
	hp.init(&st, &ctx);
	usz? h = hp.execute(buf);
	if (catch e = h)
	{
		io::printfn("  http.c3l FAIL: %s", e);
		ok = false;
	}
	else if (h != buf.len || ctx.headers != EXPECT_HEADERS)
	{
		io::printfn("  http.c3l FAIL: consumed=%d/%d headers=%d", h, buf.len, ctx.headers);
		ok = false;
	}
	else
	{
		io::printfn("  http.c3l ok   consumed=%d headers=%d", h, ctx.headers);
	}

	sink += ctx.sink;
	return ok;
}

// whole head in one buffer
fn double whole_zparse1(char[] buf)
{
	ZString z = (ZString)buf.ptr;
	zparse1::ZHttpRequest r;
	for (usz i = 0; i < WARMUP; i++) { r = {}; (void)zparse1::parse(&r, z, buf.len); }

	Clock t = clock::now();
	for (usz i = 0; i < ITERS; i++)
	{
		r = {};
		if (zparse1::parse(&r, z, buf.len)) sink += (ulong)r.header_count;
	}
	return (double)(long)t.mark() / (double)ITERS;
}

fn double whole_zparseng(char[] buf)
{
	ZString z = (ZString)buf.ptr;
	zparseng::ZHttpRequest r;
	for (usz i = 0; i < WARMUP; i++) (void)zparseng::parse(&r, z, buf.len);

	Clock t = clock::now();
	for (usz i = 0; i < ITERS; i++)
	{
		usz? n = zparseng::parse(&r, z, buf.len);
		if (try n) sink += n;
	}
	return (double)(long)t.mark() / (double)ITERS;
}

fn double whole_httpc3l(char[] buf)
{
	Ctx ctx;
	parser::Settings st = full_settings();
	parser::Parser p;
	for (usz i = 0; i < WARMUP; i++) { p.init(&st, &ctx); (void)p.execute(buf); }

	Clock t = clock::now();
	for (usz i = 0; i < ITERS; i++)
	{
		p.init(&st, &ctx);
		usz? n = p.execute(buf);
		if (try n) sink += n;
	}
	double ns = (double)(long)t.mark() / (double)ITERS;
	sink += ctx.sink;
	return ns;
}

// split arrival

fn double chunked_zparse1(char[] buf, usz chunk, usz iters)
{
	ZString z = (ZString)buf.ptr;
	zparse1::ZHttpRequest r;
	Clock t = clock::now();
	for (usz i = 0; i < iters; i++)
	{
		usz have = 0;
		while (have < buf.len)
		{
			have += chunk;
			if (have > buf.len) have = buf.len;
			r = {};
			if (zparse1::parse(&r, z, have)) { sink += (ulong)r.header_count; break; }
		}
	}
	return (double)(long)t.mark() / (double)iters;
}

fn double chunked_zparseng(char[] buf, usz chunk, usz iters)
{
	ZString z = (ZString)buf.ptr;
	zparseng::ZHttpRequest r;
	Clock t = clock::now();
	for (usz i = 0; i < iters; i++)
	{
		zparseng::ZHttpParser p = { .request = &r };
		usz have = 0;
		while (have < buf.len)
		{
			have += chunk;
			if (have > buf.len) have = buf.len;
			usz? n = p.parse(z, have);
			if (try n) { sink += n; break; }
		}
	}
	return (double)(long)t.mark() / (double)iters;
}

fn double chunked_httpc3l(char[] buf, usz chunk, usz iters)
{
	Ctx ctx;
	parser::Settings st = full_settings();
	parser::Parser p;
	Clock t = clock::now();
	for (usz i = 0; i < iters; i++)
	{
		p.init(&st, &ctx);
		usz pending = 0;
		usz off = 0;
		while (off < buf.len)
		{
			usz end = off + chunk;
			if (end > buf.len) end = buf.len;
			char[] window = buf[off - pending .. end - 1];
			usz? n = p.execute(window);
			if (try n) { pending = window.len - n; sink += n; }
			off = end;
		}
	}
	double ns = (double)(long)t.mark() / (double)iters;
	sink += ctx.sink;
	return ns;
}

fn void log(String name, double ns, usz bytes)
{
	double reqs = 1_000_000_000.0 / ns;
	io::printfn("  %-24s %10.1f ns %8.2f M req/s %8.0f MB/s",
	            name, ns, reqs / 1_000_000.0, reqs * (double)bytes / 1048576.0);
}

fn int main()
{
	char[] buf = (char[])REQ;
	io::printfn("head: %d bytes, %d headers\n", buf.len, EXPECT_HEADERS);

	io::printn("correctness:");
	if (!check(buf))
	{
		io::printn("\nsomething is broken - refusing to report timings");
		return 1;
	}

	io::printn("\nwhole head in one buffer:");
	log("zparse", whole_zparse1(buf), buf.len);
	log("zparseng",  whole_zparseng(buf), buf.len);
	log("http.c3l",            whole_httpc3l(buf), buf.len);

	io::printn("\n64-byte chunks:");
	log("zparse1", chunked_zparse1(buf, 64, CHUNK_ITERS / 10), buf.len);
	log("zparseng",   chunked_zparseng(buf, 64, CHUNK_ITERS), buf.len);
	log("http.c3l",   chunked_httpc3l(buf, 64, CHUNK_ITERS), buf.len);

	io::printn("\nbyte at a time:");
	log("zparse1", chunked_zparse1(buf, 1, SLOW_ITERS / 10), buf.len);
	log("zparseng",   chunked_zparseng(buf, 1, SLOW_ITERS), buf.len);
	log("http.c3l",   chunked_httpc3l(buf, 1, SLOW_ITERS), buf.len);

	io::printfn("\nsink=%d", sink);
	return 0;
}